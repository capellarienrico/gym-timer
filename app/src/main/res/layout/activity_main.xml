<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GYM TIMER"
            android:textColor="@color/accent_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descanso com Vibração Máxima"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Overlay Permission Card (shown if permission is missing) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#263238"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/accent_orange"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Janela Flutuante Desativada"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/overlay_permission_desc"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/accent_orange"
                    android:text="@string/grant_permission"
                    android:textColor="@color/black_bg"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Big Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_timer_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="PRONTO"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMainTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.04"
                android:text="01:00"
                android:textColor="@color/text_white"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vibração no final"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick Presets Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="TEMPOS PREDEFINIDOS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- 3 Presets in a row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreset45s"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/card_bg"
                android:text="@string/preset_45s"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreset1m"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/card_bg"
                android:text="@string/preset_1m"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreset1m30s"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_bg"
                android:text="@string/preset_1m30s"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <!-- Custom Adjustments Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AJUSTAR TEMPO"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus15s"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/card_bg"
                android:text="-15s"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd15s"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/card_bg"
                android:text="+15s"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd30s"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_bg"
                android:text="+30s"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Main Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/card_bg"
                android:text="@string/stop"
                android:textColor="@color/accent_red"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/accent_red"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartPause"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:backgroundTint="@color/accent_green"
                android:text="@string/start"
                android:textColor="@color/black_bg"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Minimize / Floating info -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinimize"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Minimizar para janela flutuante ↘"
            android:textColor="@color/accent_green"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
